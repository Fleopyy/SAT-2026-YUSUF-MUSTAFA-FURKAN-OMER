<Files "check_db.php">
    Require all denied
</Files>

# Stage 4D: secrets and database/backup exports.
<FilesMatch "(?i)(^\.|\.(sql|sqlite|sqlite3|db|bak|old|orig|save|swp|ini|log)$|^database\.local\.|^mail\.local\.)">
    Require all denied
</FilesMatch>

# Stage 4C: single security header owner, including static/error responses.
# No HTTPS redirect or HSTS until deployment TLS is verified.
# CSP observation only; migrate inline scripts/styles/handlers before enforcement.
# No report collector: inspect browser console, no external reporting.
<IfModule mod_headers.c>
    Header onsuccess unset X-Content-Type-Options
    Header always set X-Content-Type-Options "nosniff"
    Header onsuccess unset Referrer-Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header onsuccess unset X-Frame-Options
    Header always set X-Frame-Options "SAMEORIGIN"
    Header onsuccess unset Permissions-Policy
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header onsuccess unset Content-Security-Policy-Report-Only
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js; script-src-attr 'none'; style-src 'self' https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css https://cdnjs.cloudflare.com/ajax/libs/font-awesome/ https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' https://cdnjs.cloudflare.com/ajax/libs/font-awesome/ https://fonts.gstatic.com; connect-src 'self'; frame-src 'none'; worker-src 'self'; manifest-src 'self'"
</IfModule>
